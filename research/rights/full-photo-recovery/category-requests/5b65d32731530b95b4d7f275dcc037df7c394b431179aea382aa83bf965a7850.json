ommons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":30703548,"ns":6,"title":"File:Scadding Cabin 01.JPG","imagerepository":"local","imageinfo":[{"size":3835067,"width":3456,"height":2304,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Scadding_Cabin_01.JPG/960px-Scadding_Cabin_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":800,"thumbheight":533,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Scadding_Cabin_01.JPG/1920px-Scadding_Cabin_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Scadding_Cabin_01.JPG/960px-Scadding_Cabin_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":800,"height":533,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Scadding_Cabin_01.JPG/1920px-Scadding_Cabin_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/ab/Scadding_Cabin_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Scadding_Cabin_01.JPG","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=30703548","extmetadata":{"DateTime":{"value":"2014-01-19 22:52:51","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Scadding Cabin 01","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon EOS 350D|Scadding Cabin|Self-published work","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The Scadding Cabin in Exhibition Place, Toronto. This log cabin was built in 1794, making it Toronto's oldest known surviving house. The sign in front of the cabin says:\n<p><i>This log cabin, Toronto’s oldest known surviving house, was constructed for John Scadding in 1794 during the first years of British settlement. Scadding was a government clerk and close friend of Lieutenant-Governor John Graves Simcoe. The cabin stood on the east side of the Don River on a 253-acre land grant that stretched north from Lake Ontario to present-day Danforth Avenue. Scadding lived there until he went back to England with the Simcoes in 1796.</i>\n</p><p>When Scadding returned to York 1818, he sold the cabin and its property to farmer William Smith, who used the cabin as an outbuilding. In 1879, the Smith family offered the cabin to the 10-year-old York Pioneers Association; Scadding’s son Henry, a prominent Toronto historian, was a founding member.\n</p>\nIn the summer of 1879, in an early act of Toronto heritage preservation, the York Pioneers dismantled the cabin and reassembled it at this location for the inaugural Toronto Industrial Exhibition, now the Canadian National Exhibition.<i></i>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-01-18 10:48:53","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:Halava&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Halava (page does not exist)\">Halava</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-3.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":30703549,"ns":6,"title":"File:Scadding Cabin 03.JPG","imagerepository":"local","imageinfo":[{"size":4570890,"width":3456,"height":2304,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Scadding_Cabin_03.JPG/960px-Scadding_Cabin_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":800,"thumbheight":533,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Scadding_Cabin_03.JPG/1920px-Scadding_Cabin_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Scadding_Cabin_03.JPG/960px-Scadding_Cabin_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":800,"height":533,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Scadding_Cabin_03.JPG/1920px-Scadding_Cabin_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Scadding_Cabin_03.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Scadding_Cabin_03.JPG","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=30703549","extmetadata":{"DateTime":{"value":"2014-01-19 22:52:50","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Scadding Cabin 03","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon EOS 350D|Scadding Cabin|Self-published work","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"