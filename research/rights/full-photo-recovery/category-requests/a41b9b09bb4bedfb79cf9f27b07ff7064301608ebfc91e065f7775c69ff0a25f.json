78,"height":621,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/3/37/Alegoria_%C3%A0_Institui%C3%A7%C3%A3o_da_Academia_das_Belas_Artes_%281840%29_-_Norberto_Jos%C3%A9_Ribeiro.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":800,"thumbheight":1039,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/3/37/Alegoria_%C3%A0_Institui%C3%A7%C3%A3o_da_Academia_das_Belas_Artes_%281840%29_-_Norberto_Jos%C3%A9_Ribeiro.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":800,"height":1039},"url":"https://upload.wikimedia.org/wikipedia/commons/3/37/Alegoria_%C3%A0_Institui%C3%A7%C3%A3o_da_Academia_das_Belas_Artes_%281840%29_-_Norberto_Jos%C3%A9_Ribeiro.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Alegoria_%C3%A0_Institui%C3%A7%C3%A3o_da_Academia_das_Belas_Artes_(1840)_-_Norberto_Jos%C3%A9_Ribeiro.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=46423785","extmetadata":{"DateTime":{"value":"2016-01-16 12:12:18","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\n<div style=\"font-weight:bold;display:inline-block;\"><div style=\"display:inline-block\" dir=\"ltr\" lang=\"en\"><i>Allegory to the Establishment of the Academy of Fine Arts</i></div></div><div style=\"display: none;\">label QS:Len,\"Allegory to the Establishment of the Academy of Fine Arts\"</div><div style=\"display: none;\">label QS:Lpt,\"Alegoria à Instituição da Academia das Belas Artes\"</div></div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"19th-century paintings in Portugal|1840s paintings from Portugal|Passos Manuel|D. Maria II: de Princesa Brasileira a Rainha de Portugal (1819–1853)|1840 paintings|PD-old-100-expired|PD-Art (PD-old-auto-expired)|Artworks with Wikidata item|1840s allegorical paintings|CC-PD-Mark|Artworks with Wikidata item missing medium|Maria II of Portugal in art|Artworks digital representation of 2D work|Paintings of people with sculptures|Men and women shaking hands in art|Paintings of people wearing armour","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q23771068\" class=\"extiw\" title=\"d:Q23771068\"><span title=\"painter\">Norberto José Ribeiro</span></a></bdi>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n\"Allegory to the Establishment of the Academy of Fine Arts\" (1840), by Norberto José Ribeiro. It is an allegorical painting, representing the establishment of the Academy of Fine Arts in Lisbon and Oporto. In an interior palace setting, in classical architecture, one can see, in the centre of the composition, a statue of Queen Maria II, over a plinth and surrounded by allegorical characters, both sitting and standing, dressed in the fashion of the Antiquity, representing the classical disciplins of the Fine Arts. To the right, standing and clad in armour, an allegory of Passos Manuel, Minister of the Kingdom, who signed the decrees that established the Academy.</div>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1840<div style=\"display: none;\">date QS:P571,+1840-00-00T00:00:00Z/9</div>","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"http://www.academiabelasartes.pt/\">Academia Nacional de Belas Artes</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"com