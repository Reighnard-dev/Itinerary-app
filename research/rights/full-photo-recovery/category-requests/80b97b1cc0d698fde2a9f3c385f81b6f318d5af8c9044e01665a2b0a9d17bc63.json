me":{"value":"Joshua Cohen reading from his book at the English Theatre Berlin (15553664933)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"English Theatre Berlin|PD US DOS|Joshua Cohen (writer)|Jörg Thadeusz|Images with extracted images|September 2014 in Berlin|Flickr images reviewed by FlickreviewR 2|Photographs from U.S. embassy in Berlin Flickr stream|Embassy files uploaded by Tyler de Noche","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Joshua Cohen reading from his book at the English Theatre Berlin, September 22, 2014 (with German presenter <a href=\"//commons.wikimedia.org/wiki/Category:J%C3%B6rg_Thadeusz\" title=\"Category:Jörg Thadeusz\">Jörg Thadeusz</a>)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2015-01-02 03:24","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/usbotschaftberlin/15553664933/\">Joshua Cohen reading from his book at the English Theatre Berlin</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/92908405@N07\">usbotschaftberlin</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":89461509,"ns":6,"title":"File:Joshua Hammer in Berlin, 2016.jpg","imagerepository":"local","imageinfo":[{"size":78243,"width":851,"height":959,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Joshua_Hammer_in_Berlin%2C_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":800,"thumbheight":902,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Joshua_Hammer_in_Berlin%2C_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":800,"height":902},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Joshua_Hammer_in_Berlin%2C_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Joshua_Hammer_in_Berlin,_2016.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=89461509","extmetadata":{"DateTime":{"value":"2020-04-25 04:09:08","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Joshua Hammer in Berlin, 2016","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"English Theatre Berlin|American Academy Berlin|PD US DOS|Files from external sources with reviewed licenses|Joshua Hammer|June 2016 in Berlin|Photographs from U.S. Embassy Berlin","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Am Dienstag präsentierte die amerikanische Botschaft Berlin in Kooperation mit der <a href=\"//commons.wikimedia.org/wiki/Category:American_Academy_Berlin\" title=\"Category:American Academy Berlin\">The American Academy in Berlin</a> und dem <a href=\"//commons.wikimedia.org/wiki/Category:English_Theatre_Berlin\" title=\"Category:English Theatre Berlin\">English Theatre Berlin</a> die Lesung des amerikanischen Journalisten und Autors <a href=\"//commons.wikimedia.org/wiki/Category:Joshua_Hammer\" title=\"Category:Joshua Hammer\">Joshua Hammer</a>. In seinem Buch „The Bad-Ass Librarians of Timbuktu“ (Simon &amp; Schuster, 2016) erzählt er die Geschichte eines liebenswürdigen malischen Bibliothekars, der in Timbuktu mehr als 350000 alte islamische Texte vor der Zerstörung durch Islamisten rettet. Diese über Jahrhunderte gesammelten Manuskripte sind eine der wenigen Relikte eines einst blühenden Zentrums islamischer Wissenschaft im subsaharischen Afrika. Hammers Buch ist ein mitreißender Bericht über Mut, Diplomatie und dem Triumph der Toleranz und Zivilisation über Ignoranz und Barbarei.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-06-30","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.facebook.com/usbotschaftberlin/photos/a.155904654459337/1035766843139776/?type=3&amp;theater\">U.S. Embassy Berlin</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.facebook.com/pg/usbotschaftberlin/\">usbotschaftberlin</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":116382141,"ns":6,"title":"File:Joshua Cohen reading from his book at the English Theatre Berlin (15553664933) (cropped).jpg","imagerepository":"local","imageinfo":[{"size":485589,"width":1192,"height":1279,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Joshua_Cohen_reading_from_his_book_at_the_English_Theatre_Berlin_%2815553664933%29_%28cropped%29.jpg/960px-Joshua_Cohen_reading_from_his_book_at_the_English_Theatre_Berlin_%2815553664933%29_%28cropped%29.jpg?utm_source=comm