campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":800,"height":564,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Harrisons_Cave_%286975342587%29.jpg/1920px-Harrisons_Cave_%286975342587%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/4/47/Harrisons_Cave_%286975342587%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Harrisons_Cave_(6975342587).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=24489989","extmetadata":{"DateTime":{"value":"2013-02-06 12:12:46","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Harrisons Cave (6975342587)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Nikon D80|2011 in Barbados|Harrison's Cave|Flickr images reviewed by File Upload Bot (Magnus Manske)|Files with coordinates missing SDC location of creation|Photographs by Berit Watkin","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"13.181788","source":"commons-desc-page"},"GPSLongitude":{"value":"-59.583406","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Harrison’s Cave\n</p><p>At the heart of Barbados lies one of its greatest wonders, Harrison’s Cave. \n</p><p>Located in the central uplands of the island, this breathtakingly beautiful, crystallised limestone cavern is a testament to nature’s mastery. \n</p><p>Flowing streams, deep pools of crystal clear water and towering columns characterise this living cave. \n</p><p>Gaze in wonder at the white flowstones and in awe at the beauty of the speleothems which adorn the cave. \n</p><p>Harrison’s Cave is named for Thomas Harrison, who owned much of the land in the area in the early 1700s. In 1733, Harrison established a school that is today’s Harrison College. It’s not clear whether Mr. Harrison ever entered the cave that bears his name  but others certainly did.\n</p><p>During the 18th and 19th centuries, several expeditions ventured into Harrison’s Cave, none of which got very far. Because the natural entrances to Harrison’s Cave were hard to get to, and the cave’s inside passages presented many challenges, the cave remained an unexplored mystery until 1970.\n</p>\nRediscovered and mapped in 1974 by Ole Sorensen.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-11-14 14:56","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/ben124/6975342587/\">Harrison's Cave</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/9298216@N08\">Berit</a> from Redhill/Surrey, UK","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},{"pageid":24489990,"ns":6,"title":"File:Harrisons Cave (6976862065).jpg","imagerepository":"local","imageinfo":[{"size":6782769,"width":2757,"height":2592,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Harrisons_Cave_%286976862065%29.jpg/960px-Harrisons_Cave_%286976862065%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":800,"thumbheight":752,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Harrisons_Cave_%286976862065%29.jpg/1920px-Harrisons_Cave_%286976862065%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Harrisons_Cave_%286976862065%29.jpg/960px-Harrisons_Cave_%286976862065%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":800,"height":752,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Harrisons_Cave_%286976862065%29.jpg/1920px-Harrisons_Cave_%286976862065%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Harrisons_Cave_%286976862065%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Harrisons_Cave_(6976862065).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=24489990","extmetadata":{"DateTime":{"value":"2013-02-06 12:12:47","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Harrisons Cave (6976862065)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"2012 in Barbados|Harrison's Cave|Flickr images reviewed by File Upload Bot (Magnus Manske)|Files with coordinates missing SDC location of creation|Photographs by Berit Watkin","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"13.187638","source":"commons-desc-page"},"GPSLongitude":{"value":"-59.587869","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>At the heart of Barbados lies one of its greatest wonders, Harrison’s Cave. Located in the central uplands of the island, this breathtakingly beautiful, crystallised limestone cavern is a testament to nature’s mastery. \n</p><p>Flowing streams, deep pools of crystal clear water and towering columns characterise this living cave. \n</p><p>Gaze in wonder at the white flowstones and in awe at the beauty of the speleothems which adorn the cave. \nHarrison’s Cave is named for Thomas Harrison, who owned much of the land in the area in the early 1700s. In 1733, Harrison established a school that is today’s Harrison College. It’s not clear whether Mr. Harrison ever entered the cave that bears his name  but others certainly did.\n</p><p>During the 18th and 19th centuries, several expeditions ventured into Harrison’s Cave, none of which got very far. Because the natural entrances to Harrison’s Cave were hard to get to, and the cave’s inside passages presented many challenges, the cave remained an unexplored mystery until 1970.\n</p>\nRediscovered and mapped in 1974 by Ole Sorensen.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2012-02-19 13:01","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/ben124/6976862065/\">Harrison's Cave</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/9298216@N08\">Berit</a> from Redhill/Surrey, UK","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value"