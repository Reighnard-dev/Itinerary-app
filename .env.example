# Put server settings in .env and only VITE_ public settings in .env.local.
# Leave blank to use the local SQLite demo with real local accounts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
# Use true when serving behind HTTPS in production.
COOKIE_SECURE=false
# Public URL/contact for your deployment when making Wikimedia photo requests.
PHOTO_SOURCE_CONTACT=http://localhost:3001

# Vite browser client. Public anon key only; never use service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps Platform Configuration (Optional for development; app falls back cleanly if omitted)
# Server-side key for Google Routes API (Routes API v2 computeRoutes). Keep private on server; restrict by API.
GOOGLE_ROUTES_API_KEY=
# Client-side key for Google Maps JavaScript API. Restrict by HTTP referrer domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
