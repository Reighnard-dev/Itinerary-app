# Copy to .env, then run the SQL in supabase/schema.sql in your project.
# Leave blank to use the local SQLite demo with real local accounts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
# Use true when serving behind HTTPS in production.
COOKIE_SECURE=false
# Public URL/contact for your deployment when making Wikimedia photo requests.
PHOTO_SOURCE_CONTACT=http://localhost:3001
