{
  "name": "roam-itinerary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:rights": "tsx scripts/audit-rights.ts",
    "release:check": "node scripts/software-notices.mjs && tsx scripts/audit-rights.ts --release",
    "build:release": "npm run build",
    "prestart": "npm run release:check",
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:netlify": "npm run prebuild && tsc -b && vite build --mode netlify && tsx scripts/publish-discovery.ts && npm run postbuild",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:netlify": "node tests/netlify-discovery.mjs",
    "data:world": "node scripts/import-world.mjs",
    "data:guides": "tsx scripts/import-guides.ts",
    "data:photos": "tsx scripts/import-place-photos.ts",
    "data:guide-dump": "node scripts/download-guide-dump.mjs",
    "data:expanded-guides": "node --max-old-space-size=6144 --import tsx scripts/import-world-guides.ts",
    "data:guide-coordinates": "tsx scripts/enrich-guide-coordinates.ts",
    "data:geographic": "tsx scripts/import-geographic-places.ts",
    "data:country-maps": "tsx scripts/import-country-maps.ts",
    "data:expansion-photos": "tsx scripts/import-expansion-photos.ts",
    "data:coverage": "tsx scripts/audit-expansion.ts",
    "data:overture-query": "tsx scripts/prepare-overture-import.ts",
    "data:overture-import": "tsx scripts/import-overture-places.ts",
    "data:knowledge": "tsx scripts/import-knowledge-places.ts",
    "prebuild": "node scripts/software-notices.mjs && tsx scripts/publish-rights.ts && tsx scripts/audit-rights.ts --release --source-only",
    "postbuild": "tsx scripts/audit-rights.ts --release"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
